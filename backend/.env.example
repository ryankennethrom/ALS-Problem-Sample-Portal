DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL. Use provider credentials instead of this local-development example in production.
DATABASE_URL=postgresql://problem_sample_tracker:problem_sample_tracker@127.0.0.1:5432/problem_sample_tracker

# Staff username/password sessions.
SESSION_EXPIRES_HOURS=12

# Public frontend used to build problem-sample tracking links.
FRONTEND_URL=http://localhost:3000

# Public tracking protection. Leave proxy hops at 0 unless your trusted ingress
# appends X-Forwarded-For in a verified way; otherwise REMOTE_ADDR is used.
PUBLIC_TRACKING_TRUSTED_PROXY_HOPS=0
PUBLIC_TRACKING_READ_LIMIT_PER_MINUTE=60
PUBLIC_TRACKING_READ_LIMIT_PER_HOUR=600
PUBLIC_TRACKING_WRITE_LIMIT_PER_MINUTE=10
PUBLIC_TRACKING_WRITE_LIMIT_PER_HOUR=60
