DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL. Use provider credentials instead of this local-development example in production.
DATABASE_URL=postgresql://problem_sample_tracker:problem_sample_tracker@127.0.0.1:5432/problem_sample_tracker

# MVP login policy
AUTH_ALLOWED_DOMAIN=alsglobal.com
# Optional comma-separated explicit allowlist. Blank means any verified address on AUTH_ALLOWED_DOMAIN.
AUTH_ALLOWED_EMAILS=
SESSION_EXPIRES_HOURS=12

# Email backend. Console is safest/easiest locally.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Edmonton Problem Sample Tracker <noreply@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Public frontend used when creating links in future email templates
FRONTEND_URL=http://localhost:3000
